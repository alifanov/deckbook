generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Владелец. Строка ровно одна; пароль приходит из переменной окружения
/// при первом входе и хранится хешем.
model Owner {
  id           Int    @id @default(1)
  passwordHash String
  /// растёт на каждом выходе — старые cookie перестают действовать сразу,
  /// в том числе на устройстве, которое осталось где-то ещё
  sessionEpoch Int    @default(0)
}

model Project {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// цель: состояние, к которому проект должен прийти. Свободный текст,
  /// строки — по убыванию важности. Пишет только владелец, агент читает
  /// её в project_info (ADR-0007).
  goal      String   @default("")
  /// абсолютный путь к чекауту проекта на машине владельца: им кнопка
  /// «Исправить» открывает в Claude Code нужную папку, а не последнюю
  localPath String   @default("")
  createdAt DateTime @default(now())

  tokens    Token[]
  tasks     Task[]
  documents Document[]
}

model Token {
  id         String    @id @default(cuid())
  name       String
  hash       String    @unique
  projectId  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTasks  Task[]     @relation("assignee")
  createdTasks   Task[]     @relation("taskCreator")
  comments       Comment[]
  editedDocs     Document[] @relation("docEditor")
}

enum TaskStatus {
  todo
  in_progress
  /// работа упёрлась в ответ человека: агент дальше не идёт, задача уходит
  /// владельцу в «Мои задачи»
  needs_human
  done
  cancelled
}

/// порядок объявления — это и порядок сортировки: high идёт первым при desc
enum TaskPriority {
  low
  normal
  high
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  parentId    String?
  title       String
  description String     @default("")
  status      TaskStatus @default(todo)
  /// важность задачи — тай-брейк внутри одного срока, а не отдельная очередь
  priority    TaskPriority @default(normal)
  /// интервал повторения в днях; null у обычной задачи
  recurrence  Int?
  /// срок: день, в который задачу надо сделать. До срока задача не попадает
  /// в списки агента, после — считается просроченной (ADR-0004).
  /// У повторяющейся задачи тот же срок сдвигается при закрытии.
  dueAt        DateTime? @db.Date
  lastClosedAt DateTime?

  assigneeTokenId  String?
  /// исполнитель — владелец, а не агент. Взаимоисключимо с assigneeTokenId:
  /// назначение на одного снимает другого. Ничья задача — оба пусты.
  assignedToOwner  Boolean @default(false)
  createdByTokenId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Task?    @relation("subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children  Task[]   @relation("subtasks")
  assignee  Token?   @relation("assignee", fields: [assigneeTokenId], references: [id], onDelete: SetNull)
  createdBy Token?   @relation("taskCreator", fields: [createdByTokenId], references: [id], onDelete: SetNull)
  comments  Comment[]

  @@index([projectId])
  @@index([parentId])
}

enum CommentKind {
  human
  system
}

model Comment {
  id            String      @id @default(cuid())
  taskId        String
  kind          CommentKind
  body          String
  /// null означает владельца
  authorTokenId String?
  createdAt     DateTime    @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Token? @relation(fields: [authorTokenId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model Document {
  id        String  @id @default(cuid())
  projectId String
  parentId  String?
  name      String
  isFolder  Boolean @default(false)
  content   String  @default("")

  updatedByTokenId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Document?  @relation("docTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Document[] @relation("docTree")
  updatedBy Token?     @relation("docEditor", fields: [updatedByTokenId], references: [id], onDelete: SetNull)

  @@index([projectId, parentId])
}
